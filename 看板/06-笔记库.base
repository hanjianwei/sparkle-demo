filters:
  and:
    - file.ext == "md"
    - demo == "sparkle"
    - or:
        - kind == "daily"
        - kind == "topic"
    - or:
        - file.inFolder("日记")
        - file.inFolder("主题")
properties:
  file.name:
    displayName: 笔记
  note.kind:
    displayName: 类型
  note.date:
    displayName: 日记日期
  note.topic:
    displayName: 主题
  file.tags:
    displayName: 标签
  file.mtime:
    displayName: 修改时间
views:
  - type: table
    name: 全部笔记
    groupBy:
      property: kind
      direction: ASC
    order:
      - file.name
      - kind
      - date
      - topic
      - file.tags
  - type: table
    name: 日记
    filters: kind == "daily"
    order:
      - file.name
      - date
      - file.tags
  - type: table
    name: 主题笔记
    filters: kind == "topic"
    order:
      - file.name
      - topic
      - file.tags
